# ─── Gmail API ───────────────────────────────────────────────
GMAIL_CLIENT_ID=your_client_id
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REDIRECT_URI=http://localhost:3000/auth/callback
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_USER_EMAIL=your_email@gmail.com

# ─── Ollama ──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REASONING_MODEL=qwen2.5:14b
OLLAMA_DRAFTING_MODEL=mistral:7b
OLLAMA_CLASSIFICATION_MODEL=phi3:mini

# ─── PostgreSQL ──────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password
PG_DATABASE=email_agent

# ─── ChromaDB ────────────────────────────────────────────────
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=email_memory

# ─── Agent Settings ──────────────────────────────────────────
POLL_INTERVAL_MS=30000
DRAFT_ONLY_MODE=true
DEFAULT_PERSONA=support
COMPANY_NAME=TechBott
LOG_LEVEL=info

# ─── Server ──────────────────────────────────────────────────
PORT=3000
